# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────

# Set debug mode. Debug allows insecure cookies.
# ⚠️ CHANGE TO 0 IN PRODUCTION
DEBUG=1

# Public URLs where the app is reachable. UPDATE IN PRODUCTION.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8080

# Ports the app listens on.
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ──────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — generate with `openssl rand -hex 48`
POSTGRES_PASSWORD=

POSTGRES_USER=divaldi
POSTGRES_DB=divaldi

# ──────────────────────────────────────────────────────────────────────────────
# Message broker (RabbitMQ)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — generate with `openssl rand -hex 48`
RABBITMQ_PASS=

RABBITMQ_USER=admin
RABBITMQ_MANAGEMENT_PORT=15672

# ──────────────────────────────────────────────────────────────────────────────
# Task monitoring (TaskIQ)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — generate with `openssl rand -hex 48`
TASKIQ_API_TOKEN=

TASKIQ_DASHBOARD_PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# GigaChat (Sber)
# ──────────────────────────────────────────────────────────────────────────────

# Get these from https://developers.sber.ru/docs/ru/gigachat/api/reference/rest/post-token
# Scope is one of: PERS, B2B, CORP
SBER_API_KEY=mock
SBER_API_SCOPE=PERS

# See https://developers.sber.ru/docs/ru/gigachat/models/main
GIGACHAT_MODEL=GigaChat-3-Ultra

# ──────────────────────────────────────────────────────────────────────────────
# Object storage (MinIO)
# ──────────────────────────────────────────────────────────────────────────────

# ⚠️ SET A SECURE VALUE — MinIO is exposed in production, a weak password is a
#    severe security risk. Generate with `openssl rand -hex 48`
MINIO_ROOT_PASSWORD=

# Public base URL of MinIO. UPDATE IN PRODUCTION.
MINIO_URL=http://localhost:9000

MINIO_ROOT_USER=minio
MINIO_PORT=9000
MINIO_DASHBOARD_PORT=9001
