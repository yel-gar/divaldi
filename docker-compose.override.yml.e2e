services:
  frontend:
    # `!override`, not a plain list. Compose MERGES a service's ports across files,
    # so a plain list here leaves the base file's 8080 binding in place and the
    # container fails to start whenever a dev stack already holds 8080. The tag
    # replaces the list instead of extending it.
    ports: !override
      # A distinct port so an e2e run never collides with a development stack.
      - "${E2E_FRONTEND_PORT:-18080}:80"
    build:
      args:
        BACKEND_URL: ""
    environment:
      E2E: "1"

  # pymupdf has no musl/aarch64 wheel, so every service built from
  # backend/Dockerfile must build under linux/amd64 (Rosetta on ARM Macs).
  # The garage image itself stays native, so the platform cannot be forced
  # globally. Same pins as docker-compose.override.yml.dev.
  backend:
    platform: linux/amd64
    ports: !reset []
    environment:
      # The offline provider: no GigaChat calls, no credentials, deterministic
      # output. Every request still exercises the real router, the real workers
      # and the real MinIO/Redis/PostgreSQL stack.
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"
      MOCK_PROVIDER_MODE: "${E2E_MOCK_MODE:-kp}"
      DEBUG: "0"

  migrate:
    platform: linux/amd64
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"

  scheduler:
    platform: linux/amd64
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"

  worker_default:
    platform: linux/amd64
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"

  worker_network:
    platform: linux/amd64
    environment:
      SBER_API_KEY: "mock"
      SBER_API_SCOPE: "PERS"

  garage-config:
    platform: linux/amd64

  taskiq_dashboard:
    ports: !reset []

  rabbitmq:
    ports: !reset []

  garage:
    ports: !reset []
